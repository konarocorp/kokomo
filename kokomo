def calc_guide_position(*, guides, index, length, margin):
    guides = eva.normalize_integer(guides, minimum=2)
    length = eva.normalize_integer(length, minimum=1)
    margin = eva.normalize_integer(margin, minimum=0)
    index  = eva.normalize_float(index, maximum=guides, minimum=1.0)

    windows  = guides - 1
    free     = length - (guides * margin)
    step     = margin + (free / windows)
    position = step * (index - 1)

    # prevent corrupting height/width Grid properties with negative positions
    return max(position, 0)




def calc_positions_and_sizes(*, cpus):
    cpus   = eva.normalize_integer(cpus, minimum=1)
    height = TERMINAL.height
    width  = TERMINAL.width
    margin = M.math.sqrt(height * width) / 100 * MARGIN_PERCENTAGE
    margin = eva.normalize_integer(margin, minimum=0)

    # 11 -> gh1 + wsmoothed + gh2 + wload + gh3 + wminimum + gh4 + wcurrent + gh5 + wmaximum + gh6
    if height < 11:
        margin = 0

    gh0 = GUIDES.h0
    gh1 = GUIDES.h1
    gh2 = GUIDES.h2
    gh3 = GUIDES.h3
    gh4 = GUIDES.h4
    gh5 = GUIDES.h5
    gh6 = GUIDES.h6

    gv1 = GUIDES.v1
    gv2 = GUIDES.v2
    gv3 = GUIDES.v3

    wcpus      = WINDOWS.cpus
    wcurrent   = WINDOWS.current
    whistogram = WINDOWS.histogram
    wload      = WINDOWS.load
    wmaximum   = WINDOWS.maximum
    wminimum   = WINDOWS.minimum
    wsmoothed  = WINDOWS.smoothed

    gv1.set_geometry(height=height, width=margin, x=0, y=0)

    gv2.set_geometry(
        height=height,
        width=margin,
        x=calc_guide_position(index=2.4, length=width, margin=margin, guides=3),
        y=0
    )

    gv3.set_geometry(
        height=height,
        width=margin,
        x=calc_guide_position(index=3, length=width, margin=margin, guides=3),
        y=0
    )

    gh1.set_geometry(height=margin, width=width, x=0, y=0)

    gh2.set_geometry(
        height=margin,
        width=(gv3.x + gv3.width) - gv2.x,
        x=gv2.x,
        y=calc_guide_position(index=2, length=height, margin=margin, guides=6)
    )

    gh3.set_geometry(
        height=margin,
        width=gh2.width,
        x=gh2.x,
        y=calc_guide_position(index=3, length=height, margin=margin, guides=6)
    )

    gh4.set_geometry(
        height=margin,
        width=gh2.width,
        x=gh2.x,
        y=calc_guide_position(index=4, length=height, margin=margin, guides=6)
    )

    gh5.set_geometry(
        height=margin,
        width=gh2.width,
        x=gh2.x,
        y=calc_guide_position(index=5, length=height, margin=margin, guides=6)
    )

    gh6.set_geometry(
        height=margin,
        width=width,
        x=0,
        y=calc_guide_position(index=6, length=height, margin=margin, guides=6)
    )

    gh0.set_geometry(
        height=margin,
        width=(gv1.width + gv2.x + gv2.width),
        x=0,
        y=calc_guide_position(index=2, length=height, margin=margin, guides=3)
    )
    gh0.set_geometry(
        # 3 -> border + header + border, 1 -> header
        y=min(gh0.y, cpus + (3 if wcpus.border else 1) + gh1.height)
    )

    if margin:
        gv1.set_geometry(width=gv1.width + margin)
        gv2.set_geometry(width=gv2.width + margin)
        gv3.set_geometry(width=gv3.width + margin, x=gv3.x - margin)

    wcpus.set_geometry(
        height=gh0.y - gh1.y - gh1.height,
        width=gv2.x - gv1.x - gv1.width,
        x=gv1.x + gv1.width,
        y=gh1.y + gh1.height
    )

    whistogram.set_geometry(
        height=gh6.y - gh0.y - gh0.height,
        width=wcpus.width,
        x=wcpus.x,
        y=gh0.y + gh0.height
    )

    wsmoothed.set_geometry(
        height=gh2.y - gh1.y - gh1.height,
        width=gv3.x - gv2.x - gv2.width,
        x=gv2.x + gv2.width,
        y=gh1.y + gh1.height
    )

    wload.set_geometry(
        height=gh3.y - gh2.y - gh2.height,
        width=wsmoothed.width,
        x=wsmoothed.x,
        y=gh2.y + gh2.height
    )

    wminimum.set_geometry(
        height=gh4.y - gh3.y - gh3.height,
        width=wsmoothed.width,
        x=wsmoothed.x,
        y=gh3.y + gh3.height
    )

    wcurrent.set_geometry(
        height=gh5.y - gh4.y - gh4.height,
        width=wsmoothed.width,
        x=wsmoothed.x,
        y=gh4.y + gh4.height
    )

    wmaximum.set_geometry(
        height=gh6.y - gh5.y - gh5.height,
        width=wsmoothed.width,
        x=wsmoothed.x,
        y=gh5.y + gh5.height
    )




def main():
    global EVENTS, FAHRENHEIT, FONTS, GLYPHS, GUIDES, INTERVAL_SNAPSHOT, STRESS, WINDOWS, ZONES

    if arguments := parse_arguments():
        FAHRENHEIT        = arguments.fahrenheit
        INTERVAL_SNAPSHOT = arguments.interval
        STRESS            = arguments.stress

        if arguments.help:
            show_usage_and_exit(error=False)
    else:
        show_usage_and_exit(error=True)

    M.signal.signal(M.signal.SIGHUP,   signal_handler_graceful_exit)
    M.signal.signal(M.signal.SIGINT,   signal_handler_graceful_exit)
    M.signal.signal(M.signal.SIGTERM,  signal_handler_graceful_exit)
    M.signal.signal(M.signal.SIGWINCH, signal_handler_window_changed)

    EVENTS = build_events()
    FONTS  = build_fonts()
    GLYPHS = build_glyphs()
    ZONES  = build_zones()

    GUIDES  = build_guides()
    WINDOWS = build_windows()

    keyboard = M.threading.Thread(daemon=True, target=target_keyboard)
    mouse    = M.threading.Thread(daemon=True, target=target_mouse)
    screen   = M.threading.Thread(daemon=True, target=target_screen)
    snapshot = M.threading.Thread(daemon=True, target=target_snapshot)
    stress   = M.threading.Thread(daemon=True, target=target_stress)
    threads  = (snapshot,) + (keyboard, mouse, stress) + (screen,)

    try:
        TERMINAL.save_cursor()
        TERMINAL.enable_alt_screen()
        TERMINAL.clear_screen()
        TERMINAL.disable_cursor()
        TERMINAL.move_home()

        for thread in threads:
            thread.start()

        EVENTS.bye.wait()

        for event in vars(EVENTS).values():
            event.set()

        for thread in threads:
            thread.join()
    finally:
        TERMINAL.enable_cursor()
        TERMINAL.clear_screen()
        TERMINAL.disable_alt_screen()
        TERMINAL.restore_cursor()




def parse_arguments():
    def argparse_error_handler(message='', /):
        raise M.argparse.ArgumentError(None, message)

    parser       = M.argparse.ArgumentParser(add_help=False, allow_abbrev=False, exit_on_error=False)
    parser.error = argparse_error_handler
    regex        = M.re.compile(r'^(0|[1-9][0-9]*)(\.[0-9]+)?$')

    parser.add_argument('-f', '--fahrenheit', action='count',  default=0)
    parser.add_argument('-h', '--help',       action='count',  default=0)
    parser.add_argument('-i', '--interval',   action='append', default=[])
    parser.add_argument('-s', '--stress',     action='count',  default=0)

    try:
        arguments = parser.parse_args()
        flags     = tuple( value for value in vars(arguments).values() if isinstance(value, int) )
        interval  = arguments.interval

        if any( argument > 1 for argument in flags ):
            argparse_error_handler()

        if len(interval) > 1:
            argparse_error_handler()
        elif not interval:
            interval = INTERVAL_SNAPSHOT
        elif not regex.fullmatch(interval := interval[0]):
            argparse_error_handler()

        ret            = eva.N()
        ret.fahrenheit = bool(arguments.fahrenheit)
        ret.help       = bool(arguments.help)
        ret.interval   = eva.normalize_float(interval, maximum=60.0, minimum=0.0, precision=3)
        ret.stress     = bool(arguments.stress)
    except M.argparse.ArgumentError:
        ret = False

    return ret




def preformat_frequency(value, /, *, compact=False, ghz=False):
    compact   = bool(compact)
    fstr      = '{align}{affix}'
    ghz       = bool(ghz)
    affix     = 'GHz' if ghz else 'MHz'
    divisor   = 1000 if ghz else 1
    maximum   = 9.9 if ghz else 9999.0
    minimum   = 0.0
    padding   = 3 if ghz else 4
    precision = 1 if ghz else 0
    kwargs    = {'maximum': maximum, 'minimum': minimum, 'padding': True, 'precision': precision}
    space     = ' '
    value     = maximum if value is None else float(value) / divisor
    string    = eva.normalize_float(value, **kwargs)

    if compact:
        affix = affix[0]

    ret         = eva.N()
    ret.affix   = affix
    ret.align   = string.rjust(padding, space)
    ret.full    = fstr.format(affix=affix, align=ret.align)
    ret.compact = ret.full.strip(space)
    ret.string  = string
    ret.value   = float(string)

    return ret




def preformat_load(value, /, *, integer=False):
    affix     = '%'
    fstr      = '{align}{affix}'
    integer   = bool(integer)
    maximum   = 100.0
    minimum   = 0.0
    padding   = 3 if integer else 4
    precision = 0 if integer else 1
    kwargs    = {'maximum': maximum, 'minimum': minimum, 'padding': True, 'precision': precision}
    space     = ' '
    value     = maximum if value is None else float(value)
    string    = eva.normalize_float(value, **kwargs)
    value     = float(string)

    if value >= 100 and precision:
        kwargs['precision'] = 0

        string = eva.normalize_float(value, **kwargs)
        value  = float(string)

    ret         = eva.N()
    ret.affix   = affix
    ret.align   = string.rjust(padding, space)
    ret.color   = select_color_by_load(value)
    ret.full    = fstr.format(affix=affix, align=ret.align)
    ret.compact = ret.full.strip(space)
    ret.string  = string
    ret.value   = value

    return ret




def preformat_temperature(value, /, *, integer=False):
    affix     = '°F' if FAHRENHEIT else '°C'
    fstr      = '{align}{affix}'
    integer   = bool(integer)
    maximum   = TEMPERATURE_MAXIMUM
    minimum   = TEMPERATURE_MINIMUM
    padding   = 3 if FAHRENHEIT or integer else 4
    precision = 0 if FAHRENHEIT or integer else 1
    kwargs    = {'maximum': maximum, 'minimum': minimum, 'padding': True, 'precision': precision}
    space     = ' '
    value     = maximum if value is None else float(value)

    if FAHRENHEIT:
        fahrenheit = (value * 1.8) + 32
        string     = eva.normalize_float(fahrenheit, **kwargs)
        value      = float(string)
        celsius    = (value - 32) / 1.8
        celsius    = eva.clamp(celsius, minimum, maximum)
    else:
        string = eva.normalize_float(value, **kwargs)
        value  = float(string)

        if value >= 100 and precision:
            kwargs['precision'] = 0

            string = eva.normalize_float(value, **kwargs)
            value  = float(string)

        celsius = value

    ret         = eva.N()
    ret.affix   = affix
    ret.align   = string.rjust(padding, space)
    ret.celsius = celsius
    ret.color   = select_color_by_temperature(celsius)
    ret.full    = fstr.format(affix=affix, align=ret.align)
    ret.compact = ret.full.strip(space)
    ret.string  = string
    ret.value   = value

    return ret




def preformat_thread(value, /):
    affix     = 'CPU'
    fstr      = '{affix}{align}'
    maximum   = CPU_HIGHEST_THREAD
    minimum   = 0
    padding   = len(str(maximum))
    space     = ' '
    value     = maximum if value is None else eva.clamp(value, minimum, maximum)
    string    = str(value)

    ret         = eva.N()
    ret.affix   = affix
    ret.align   = string.ljust(padding, space)
    ret.full    = fstr.format(affix=affix, align=ret.align)
    ret.compact = ret.full.strip(space)
    ret.string  = string
    ret.value   = value

    return ret




def select_color_by_load(value, /):
    value = max(float(value), 0.0)
    zones = vars(ZONES).values()
    zones = sorted(zones, key=lambda zone: zone.load, reverse=True)
    ret   = next( zone.color for zone in zones if value >= zone.load )

