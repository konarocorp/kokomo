            yield




class Grid(Base, M.abc.ABC):
    _default_x      = 0
    _default_y      = 0
    _glyph_overflow = '╳'
    _glyphs_noise   = ('░', '▒', '█')
    _minimum_height = 0
    _minimum_width  = 0
    _style_overflow = {**Base._style_default, 'blink': True, 'fg': FG.DARK_RED, 'glyph': _glyph_overflow}
    _style_spacing  = {**Base._style_default}

    _default_geometry = {
        'height': _minimum_height,
        'width':  _minimum_width,
        'x':      _default_x,
        'y':      _default_y,
    }


    @property
    def cells(self, /):
        with self.locked():
            return self._cells


    @property
    def columns(self, /):
        with self.locked():
            return self._columns


    @property
    def height(self, /):
        with self.locked():
            return self._height


    @property
    def rows(self, /):
        with self.locked():
            return self._rows


    @property
    def width(self, /):
        with self.locked():
            return self._width


    @property
    def x(self, /):
        with self.locked():
            return self._x


    @property
    def y(self, /):
        with self.locked():
            return self._y


    def __init__(self, /):
        super().__init__()

        self._cells   = ()
        self._columns = ()
        self._height  = self._default_geometry['height']
        self._rows    = ()
        self._width   = self._default_geometry['width']
        self._x       = self._default_geometry['x']
        self._y       = self._default_geometry['y']


    def apply_default_render(self, /):
        with self.locked():
            for cell in self._cells:
                cell.set_style(**self._style_default)


    def apply_noise_render(self, /):
        with self.locked():
            choice = M.random.choice

            for cell in self._cells:
                dim   = choice((False, True))
                glyph = choice(self._glyphs_noise)
                style = {**self._style_default, 'dim': dim, 'glyph': glyph}

                cell.set_style(**style)


    def apply_overflow_render(self, /):
        with self.locked():
            for cell in self._cells:
                cell.set_style(**self._style_overflow)


    def render(self, /, *, force=False):
        pass


    @M.abc.abstractmethod
    def set_geometry(self, /):
        pass


    def set_style(self, /, *args, **kwargs):
        with self.locked():
            for cell in self._cells:
                cell.set_style(*args, **kwargs)


    def write_text(self, text, /, *, bg=None, blink=None, dim=None, fg=None, reverse=None):
        with self.locked():
            text = str(text)

            for char, cell in zip(text, self._cells):
                cell.set_style(bg=bg, blink=blink, dim=dim, fg=fg, reverse=reverse, glyph=char)




class Canvas(Grid):
    @property
    def target(self, /):
        with self.locked():
            return self._target


    def __init__(self, /, *, height=None, target, width=None, x=None, y=None):
        super().__init__()

        if isinstance(target, Canvas):
            del self._lock
        elif not isinstance(target, eva.Terminal):
            raise TypeError

        self._positions = {}
        self._queue     = set()
        self._target    = target

        __class__.set_geometry(self, height=height, width=width, x=x, y=y)


    def _print_on_target(self, /, *, force):
        force    = bool(force)
        cells    = self._cells if force else self._queue
        output   = []
        target   = self._target
        height   = target.height
        terminal = isinstance(target, eva.Terminal)
        width    = target.width

        for cell in cells:
            if force or cell.dirty:
                cell.dirty = False
            else:
                continue

            x, y = self._positions[cell]

            x = x + self._x
            y = y + self._y

            if x < 0 or y < 0:
                continue
            elif x >= width or y >= height:
                continue

            if terminal:
                output.append(f'\x1B[{y + 1};{x + 1}H')
                output.append(cell.sequence)
            else:
                # Private access is preferred for performance: not considered to
                # violate the public abstraction since both objects are the same
                # class.
                target._columns[x][y].copy_style_from(cell)

        self._queue.clear()

        if terminal:
            output = self._empty.join(output)

            target.write(output)


    @M.contextlib.contextmanager
    def locked(self, /):
        lock = self._lock if hasattr(self, '_lock') else self._target.locked()

        with lock:
            yield


    def notify(self, cell, /):
        with self.locked():
            if cell in self._positions:
                self._queue.add(cell)


    def paint(self, /, *, force=False):
        with self.locked():
            force = bool(force)

            self.render(force=force)
            self._print_on_target(force=force)


    def set_geometry(self, /, *, height=None, width=None, x=None, y=None):
        with self.locked():
            height = self._height if height is None else eva.normalize_integer(height)
            width  = self._width  if width  is None else eva.normalize_integer(width)
            x      = self._x      if x      is None else eva.normalize_integer(x)
            y      = self._y      if y      is None else eva.normalize_integer(y)

            if height < 0:
                height = max(self._target.height + height, self._minimum_height)

            if width < 0:
                width = max(self._target.width + width, self._minimum_width)

            self._x = x
            self._y = y

            if height == self._height and width == self._width:
                return

            cells     = []
            columns   = []
            positions = {}
            rows      = []

            for x in range(width):
                column = self._columns[x] if x < len(self._columns) else ()
                column = list(column[0:height])

                while len(column) < height:
                    cell = Cell(target=self)

                    column.append(cell)

                columns.append(tuple(column))

            for y in range(height):
                row = []

                for x, column in enumerate(columns):
                    cell            = column[y]
                    positions[cell] = (x, y)

                    cells.append(cell)
                    row.append(cell)

                rows.append(tuple(row))

            self._cells     = tuple(cells)
            self._columns   = tuple(columns)
            self._height    = height
            self._positions = positions
            self._queue     = { cell for cell in cells if cell.dirty }
            self._rows      = tuple(rows)
            self._width     = width




class Cell(Base):
    __slots__ = (
        '_bg',
        '_blink',
        '_dim',
        '_dirty',
        '_fg',
        '_glyph',
        '_reverse',
        '_sequence',
        '_target',
    )

    _glyph_replacement = '\uFFFD'


    @property
    def bg(self, /):
        with self.locked():
            return self._bg


    @property
    def blink(self, /):
        with self.locked():
            return self._blink


    @property
    def dim(self, /):
        with self.locked():
            return self._dim


    @property
    def dirty(self, /):
        with self.locked():
            return self._dirty


    @property
    def fg(self, /):
        with self.locked():
            return self._fg


    @property
    def glyph(self, /):
        with self.locked():
            return self._glyph


    @property
    def reverse(self, /):
        with self.locked():
            return self._reverse


    @property
    def sequence(self, /):
        with self.locked():
            if self._sequence is None:
                codes     = []
                prefix    = '\x1B['
                reset     = '\x1B[0m'
                separator = ';'
                suffix    = 'm'

                if self._reverse:
                    codes.append('7')

                if self._dim:
                    codes.append('2')

                if self._blink:
                    codes.append('5')

                codes.append(self._bg.value)
                codes.append(self._fg.value)

                self._sequence = prefix + separator.join(codes) + suffix + self._glyph + reset

            return self._sequence


    @property
    def target(self, /):
        with self.locked():
            return self._target


    @bg.setter
    def bg(self, value, /):
        if isinstance(value, BG):
            self.set_style(bg=value)
        else:
            raise TypeError


    @blink.setter
    def blink(self, value, /):
        self.set_style(blink=bool(value))


    @dim.setter
    def dim(self, value, /):
        self.set_style(dim=bool(value))


    @dirty.setter
    def dirty(self, value, /):
        with self._target.locked():
            with self.locked():
                value = bool(value)

                if value != self._dirty:
                    self._dirty = value

                    if value:
                        self._target.notify(self)


    @fg.setter
    def fg(self, value, /):
        if isinstance(value, FG):
            self.set_style(fg=value)
        else:
            raise TypeError


    @glyph.setter
    def glyph(self, value, /):
        self.set_style(glyph=str(value))


    @reverse.setter
    def reverse(self, value, /):
        self.set_style(reverse=bool(value))


    def __init__(self, /, *, bg=None, blink=None, dim=None, fg=None, glyph=None, reverse=None, target):
        super().__init__()

        if not isinstance(target, Canvas):
            raise TypeError

        self._bg       = self._style_default['bg']
        self._blink    = self._style_default['blink']
        self._dim      = self._style_default['dim']
        self._dirty    = True
        self._fg       = self._style_default['fg']
        self._glyph    = self._style_default['glyph']
        self._reverse  = self._style_default['reverse']
        self._sequence = None
        self._target   = target

        __class__.set_style(self, bg=bg, blink=blink, dim=dim, fg=fg, glyph=glyph, reverse=reverse)


    def copy_style_from(self, cell, /, *, bg=None, blink=None, dim=None, fg=None, glyph=None, reverse=None):
        if not isinstance(cell, Cell):
            raise TypeError

        # Private access is preferred for performance: not considered to violate
        # the public abstraction since both objects are the same class.
        with cell.locked():
            new = {
                'bg':      cell._bg      if bg      is None else bg,
                'blink':   cell._blink   if blink   is None else blink,
                'dim':     cell._dim     if dim     is None else dim,
                'fg':      cell._fg      if fg      is None else fg,
                'glyph':   cell._glyph   if glyph   is None else glyph,
                'reverse': cell._reverse if reverse is None else reverse,
            }

        with self.locked():
            old = {
                'bg':      self._bg,
                'blink':   self._blink,
                'dim':     self._dim,
                'fg':      self._fg,
                'glyph':   self._glyph,
                'reverse': self._reverse,
            }

            if old != new:
                self.set_style(**new)


    def set_style(self, /, *, bg=None, blink=None, dim=None, fg=None, glyph=None, reverse=None):
        with self._target.locked():
            with self.locked():
                notify = False

                if bg is not None:
                    if not isinstance(bg, BG):
                        raise TypeError

                    if bg != self._bg:
                        notify   = True
                        self._bg = bg

                if blink is not None:
                    blink = bool(blink)

                    if blink != self._blink:
                        notify      = True
                        self._blink = blink

                if dim is not None:
                    dim = bool(dim)

                    if dim != self._dim:
                        notify    = True
                        self._dim = dim

                if fg is not None:
                    if not isinstance(fg, FG):
                        raise TypeError

                    if fg != self._fg:
                        notify   = True
                        self._fg = fg

                if glyph is not None:
                    glyph = str(glyph)
                    glyph = glyph[0] if glyph else self._space

                    if glyph.isspace():
                        glyph = self._space
                    elif not glyph.isprintable():
                        glyph = self._glyph_replacement

                    if glyph != self._glyph:
                        notify      = True
                        self._glyph = glyph

                if reverse is not None:
                    reverse = bool(reverse)

                    if reverse != self._reverse:
                        notify        = True
                        self._reverse = reverse

                if notify:
                    self._dirty    = True
                    self._sequence = None

                    self._target.notify(self)




