            width  = self._width  if width  is None else eva.normalize_integer(width)
            x      = self._x      if x      is None else eva.normalize_integer(x)
            y      = self._y      if y      is None else eva.normalize_integer(y)

            if height < 0:
                height = max(self._target.height + height, self._minimum_height)

            if width < 0:
                width = max(self._target.width + width, self._minimum_width)

            self._height = height
            self._width  = width
            self._x      = x
            self._y      = y

            bottom = eva.clamp(y + height, 0, self._target.height)
            left   = eva.clamp(x,          0, self._target.width)
            right  = eva.clamp(x + width,  0, self._target.width)
            top    = eva.clamp(y,          0, self._target.height)

            cells   = []
            columns = []
            rows    = []

            for column in self._target.columns[left:right]:
                columns.append(column[top:bottom])

            for row in self._target.rows[top:bottom]:
                row = row[left:right]

                cells.extend(row)
                rows.append(row)

            self._cells   = tuple(cells)
            self._columns = tuple(columns)
            self._rows    = tuple(rows)




class Window(Canvas):
    _mask_down    = 0b01
    _mask_empty   = 0b00
    _mask_up      = 0b10
    _mask_both    = _mask_down | _mask_up
    _glyph_thumb  = '█'
    _glyphs_mask  = {_mask_both: '↕', _mask_down: '↓', _mask_empty: '┆', _mask_up: '↑'}
    _style_border = {**Base._style_default, 'dim': True}
    _style_scroll = {**Base._style_default}
    _style_title  = {**Base._style_default}


    @property
    def border(self, /):
        with self.locked():
            return self._border


    @property
    def snapshot(self, /):
        with self.locked():
            return self._snapshot


    @property
    def title(self, /):
        with self.locked():
            return self._title_string


    @border.setter
    def border(self, value, /):
        with self.locked():
            value = bool(value)

            if value != self._border:
                self._border       = value
                self._redecoration = True

                self.set_geometry()


    @snapshot.setter
    def snapshot(self, value, /):
        with self.locked():
            if not isinstance(value, ProcessorSnapshot):
                raise TypeError

            self._snapshot = value


    @title.setter
    def title(self, value, /):
        with self.locked():
            value = eva.normalize_text(value, full=True)

            if value != self._title_string:
                self._redecoration = True
                self._title_string = value

                self._adjust_title()


    def __init__(self, /, *args, border=False, title=None, **kwargs):
        super().__init__(*args, **kwargs)

        self._border        = bool(border)
        self._border_bottom = View(target=self)
        self._border_left   = View(target=self)
        self._border_right  = View(target=self)
        self._border_top    = View(target=self)
        self._padding_left  = View(target=self)
        self._padding_right = View(target=self)
        self._redecoration  = True
        self._scroll        = View(target=self)
        self._scroll_index  = 0
        self._snapshot      = None
        self._title         = View(target=self._border_top)
        self._title_string  = self._empty
        self._viewport      = View(target=self)
        self._inner         = View(target=self._viewport)

        self.title = self._empty if title is None else title

        __class__.set_geometry(self)


    def _adjust_border(self, /):
        geometry_bottom = self._default_geometry
        geometry_left   = self._default_geometry
        geometry_right  = self._default_geometry
        geometry_top    = self._default_geometry

        if self._border:
            height = self._height
            width  = self._width

            geometry_bottom = {'height': 1,      'width': -2, 'x': 1,         'y': height - 1}
            geometry_left   = {'height': height, 'width': 1,  'x': 0,         'y': 0}
            geometry_right  = {'height': height, 'width': 1,  'x': width - 1, 'y': 0}
            geometry_top    = {'height': 1,      'width': -2, 'x': 1,         'y': 0}

        self._border_bottom.set_geometry(**geometry_bottom)
        self._border_left.set_geometry(**geometry_left)
        self._border_right.set_geometry(**geometry_right)
        self._border_top.set_geometry(**geometry_top)


    def _adjust_padding(self, /):
        geometry_left  = self._default_geometry
        geometry_right = self._default_geometry

        if self._border:
            height = self._height
            width  = self._width

            geometry_left  = {'height': height - 2, 'width': 1, 'x': 1,         'y': 1}
            geometry_right = {'height': height - 2, 'width': 1, 'x': width - 2, 'y': 1}

        self._padding_left.set_geometry(**geometry_left)
        self._padding_right.set_geometry(**geometry_right)


    def _adjust_scroll(self, /):
        if self._border:
            self._scroll.set_geometry(height=-2, width=1, x=self._width - 1, y=1)
        else:
            self._scroll.set_geometry(**self._default_geometry)


    def _adjust_scroll_index(self, scroll, /):
        minimum = 0
        maximum = max(self._inner.height - self._viewport.height, minimum)

        scroll = eva.normalize_integer(scroll)
        scroll = self._scroll_index + scroll
        scroll = eva.clamp(scroll, minimum, maximum)

        if self._scroll_index != scroll:
            self._redecoration = True
            self._scroll_index = scroll

            return True
        else:
            return False


    def _adjust_title(self, /):
        border   = self._border_top
        geometry = {**self._default_geometry}

        if self._border:
            text = self._space + self._title_string + self._space
            text = text[0:border.width]

            if text:
                text     = text[0:-1] + self._space
                length   = len(text)
                x        = (border.width - length) // 2
                geometry = {'height': 1, 'width': length, 'x': x, 'y': 0}

        self._title.set_geometry(**geometry)


    def _render_helper_border(self, /):
        bottom     = self._border_bottom
        glyphs     = GLYPHS.arc
        glyphless  = { k: v for k, v in self._style_border.items() if k != 'glyph' }
        left       = self._border_left
        right      = self._border_right
        top        = self._border_top
        horizontal = glyphs.ew * top.width
        vertical   = glyphs.ns * left.height

        if not bottom.cells or not left.cells or not right.cells or not top.cells:
            return

        bottom.write_text(horizontal, **glyphless)
        left.write_text(vertical,     **glyphless)
        right.write_text(vertical,    **glyphless)
        top.write_text(horizontal,    **glyphless)

        left.cells[0].glyph   = glyphs.es
        left.cells[-1].glyph  = glyphs.ne
        right.cells[0].glyph  = glyphs.sw
        right.cells[-1].glyph = glyphs.nw


    def _render_helper_padding(self, /):
        left  = self._padding_left
        right = self._padding_right
        style = self._style_spacing

        if not left.cells or not right.cells:
            return

        left.set_style(**style)
        right.set_style(**style)


    def _render_helper_scroll(self, /):
        first_position       = 0
        glyphless_border     = { k: v for k, v in self._style_border.items() if k != 'glyph' }
        glyphless_scroll     = { k: v for k, v in self._style_scroll.items() if k != 'glyph' }
        index                = self._scroll_index
        inner                = self._inner
        second_position      = 1
        scroll               = self._scroll
        viewport             = self._viewport
        last_position        = viewport.height - 1
        penultimate_position = viewport.height - 2
        steps                = inner.height - viewport.height

        if not scroll.cells or inner.height <= viewport.height:
            return

        for y, cell in enumerate(scroll.cells):
            bitmask = self._mask_empty

            if y == first_position and index > first_position:
                bitmask = bitmask | self._mask_up

            if y == last_position and index < steps:
                bitmask = bitmask | self._mask_down

            glyph     = self._glyphs_mask[bitmask]
            glyphless = glyphless_scroll if bitmask else glyphless_border

            cell.set_style(**glyphless, glyph=glyph)

        if viewport.height > 2:
            maximum  = last_position if index == steps else penultimate_position
            minimum  = second_position if index else first_position
            position = (index / steps) * last_position
            position = eva.normalize_integer(position, maximum=maximum, minimum=minimum)
            thumb    = scroll.cells[position]

            thumb.set_style(**glyphless_scroll, glyph=self._glyph_thumb)


    def _render_helper_title(self, /):
        glyphless = { k: v for k, v in self._style_title.items() if k != 'glyph' }
        text      = self._space + self._title_string + self._space
        title     = self._title

        if not title.cells:
            return

        title.write_text(text, **glyphless)

        title.cells[0].set_style(**self._style_spacing)
        title.cells[-1].set_style(**self._style_spacing)


    def paint(self, /, *, force=False):
        with self.locked():
            force = bool(force)

            if self._viewport.cells:
                if force or self._redecoration:
                    self._render_helper_border()
                    self._render_helper_padding()
                    self._render_helper_scroll()
                    self._render_helper_title()

                    self._redecoration = False

                self.render(force=force)
            else:
                self.apply_overflow_render()

            self._print_on_target(force=force)


    def render(self, /, *, force=False):
        self.apply_noise_render()


    def scroll_down(self, /):
        with self.locked():
            if self._adjust_scroll_index(1):
                self.paint()


    def scroll_up(self, /):
        with self.locked():
            if self._adjust_scroll_index(-1):
                self.paint()


    def set_geometry(self, /, *args, **kwargs):
        with self.locked():
            super().set_geometry(*args, **kwargs)

            get_viewport_size = lambda: (viewport.height, viewport.width)
            inner             = self._inner
            viewport          = self._viewport
            previous          = get_viewport_size()

            if self._border:
                geometry = {'height': -2, 'width': -4, 'x': 2, 'y': 1}
            else:
                geometry = {'height': self._height, 'width': self._width, 'x': 0, 'y': 0}

            viewport.set_geometry(**geometry)

            if previous == get_viewport_size():
                return

            self._adjust_border()
            self._adjust_padding()
            self._adjust_scroll()
            self._adjust_title()
            inner.set_geometry(height=viewport.height, width=viewport.width, x=0, y=0)

            self._redecoration = True




class CPUsWindow(Window):
    _fields_cpu         = tuple( field.name for field in M.dataclasses.fields(CPUSnapshot) )
    _fields_sortables   = _fields_cpu[1:]
    _focus_placeholder  = 'thread'
    _glyph_bar_center   = '╳'
    _glyph_bar_fill     = '▮'
    _glyph_bar_lower    = '╱'
    _glyph_bar_upper    = '╲'
    _glyph_sort_default = '▲'
    _glyph_sort_reverse = '▼'
    _messages_monitor   = ('monitor mode', 'monitor', 'm')
    _messages_off       = ('stress test OFF', 'OFF')
    _messages_on        = ('stress test ON ({minutes}m {seconds}s)', '{minutes}m {seconds}s', 'ON')
    _style_blank        = {**Base._style_default, 'fg': FG.LIGHT_BLACK}
    _style_messages_off = {**Base._style_default, 'fg': FG.DARK_YELLOW}
    _style_messages_on  = {**Base._style_default, 'blink': True, 'fg': FG.DARK_RED}


    @Window.snapshot.setter
    def snapshot(self, value, /):
        with self.locked():
            previous = len(self._snapshot.cpus) if self._snapshot else None

            Window.snapshot.fset(self, value)

            current = len(self._snapshot.cpus)

            if previous != current:
                self._adjust_inner_height()


    def __init__(self, /, *args, **kwargs):
        super().__init__(*args, **kwargs)

        self._blank_bar   = Canvas(target=self)
        self._fields      = M.collections.deque(self._fields_cpu)
        self._label_left  = View(target=self._viewport)
        self._label_right = View(target=self._viewport)
        self._reverse     = True

        __class__.set_geometry(self)


    def _adjust_blank_bar(self, /):
        bar       = self._blank_bar
        layout    = self._layout
        width     = layout.rows[0].bar.width if layout else 0
        center    = self._glyph_bar_center if width % 2 else self._empty
        glyphless = { k: v for k, v in self._style_blank.items() if k != 'glyph' }
        lower     = self._glyph_bar_lower * M.math.floor(width / 2)
        upper     = self._glyph_bar_upper * M.math.floor(width / 2)
        text      = lower + center + upper

        bar.set_geometry(height=1, width=width)
        bar.write_text(text, **glyphless)


    def _adjust_inner_height(self, /):
        if self._snapshot:
            header = 1 if self._viewport.height > 1 else 0
            height = len(self._snapshot.cpus) + header

            self._inner.set_geometry(height=height)
            self._adjust_scroll_index(0)


    def _adjust_labels(self, /):
        focus          = self._fields[0]
        geometry_left  = self._default_geometry
        geometry_right = self._default_geometry
        layout         = self._layout
        header         = layout.rows[0] if layout and len(layout.rows) > 1 else eva.N()
        names          = tuple(vars(header).keys())

        if names:
            if focus in names and (index := names.index(focus)):
                before = names[:index]
                after  = names[index + 1:]

                if before:
                    before        = getattr(header, before[-1])
                    geometry_left = {'height': 1, 'width': before.x + before.width, 'x': 0, 'y': 0}

                if after:
                    after          = getattr(header, after[0])
                    geometry_right = {'height': 1, 'width': -after.x, 'x': after.x, 'y': 0}
            else:
                geometry_right = {'height': 1, 'width': self._viewport.width, 'x': 0, 'y': 0}

        self._label_left.set_geometry(**geometry_left)
        self._label_right.set_geometry(**geometry_right)


    def _adjust_layout(self, /):
        by_length    = lambda layout: layout.minimum
        empty        = self._empty
        fstr         = '{thread} {temperature} {load} {minscal} {frequency} {maxscal}{sep}{bar}'
        self._layout = False
        viewport     = self._viewport

        if 0 in (viewport.height, viewport.width):
            return

        layouts = (
            eva.N(compact=False, ghz=False, integer=False), # CPU0 99.9°C 99.9% 9999MHz 9999MHz 9999MHz
            eva.N(compact=True,  ghz=False, integer=False), # CPU0 99.9°C 99.9% 9999M 9999M 9999M
            eva.N(compact=True,  ghz=False, integer=True),  # CPU0 100°C 100% 9999M 9999M 9999M
            eva.N(compact=True,  ghz=True,  integer=True),  # CPU0 100°C 100% 9.9G 9.9G 9.9G
        )

        for layout in layouts:
            frequency = preformat_frequency(None, ghz=layout.ghz, compact=layout.compact).full

            kwargs = {
                'bar':         empty,
                'frequency':   frequency,
                'load':        preformat_load(None, integer=layout.integer).full,
                'maxscal':     frequency,
                'minscal':     frequency,
                'sep':         empty,
                'temperature': preformat_temperature(None, integer=layout.integer).full,
                'thread':      preformat_thread(None).full,
            }

            length            = { name: len(value) for name, value in kwargs.items() }
            layout.length     = eva.N(**length)
            layout.minimum    = len(fstr.format(**kwargs))
            free              = viewport.width - layout.minimum
            layout.length.bar = max(free - 1, 0) # 1 -> sep
            layout.length.sep = eva.clamp(free, minimum=0, maximum=1)

        for layout in sorted(layouts, key=by_length, reverse=True):
            if layout.minimum <= viewport.width:
                break
        else:
            return

        names = self._fields_cpu + ('bar',)
        rows  = []

        for y in range(viewport.height):
            row = eva.N()
            x   = 0

            for name in names:
                width = getattr(layout.length, name)
                view  = View(height=1, target=viewport, width=width, x=x, y=y)

                setattr(row, name, view)

                # 2 -> sep + space, 1 -> space
                gap = 2 if not x and layout.length.bar < layout.length.sep else 1
                x   = x + width + gap

            rows.append(row)

        self._layout = eva.N(
            compact=layout.compact,
            ghz=layout.ghz,
            integer=layout.integer,
            rows=tuple(rows),
        )


    def _render_helper_bar(self, /, *, row, snapshot):
        if not isinstance(row, tuple) or not isinstance(snapshot, CPUSnapshot):
            raise TypeError

        blank             = self._blank_bar.cells
        load              = preformat_load(snapshot.load)
        temperature       = preformat_temperature(snapshot.temperature)
        width             = len(row)
        load_cells        = eva.normalize_integer(load.value / 100 * width)
        temperature_cells = eva.normalize_integer(min(temperature.celsius, 100) / 100 * width)

        for x, source, destination, in zip(range(width), blank, row):
            style = {}

            if temperature_cells > x:
                style['bg']    = temperature.color.BG_DARK
                style['glyph'] = self._space

            if load_cells > x:
                style['fg']    = load.color.FG_LIGHT
                style['glyph'] = self._glyph_bar_fill

            destination.copy_style_from(source, **style)


    def _render_helper_header(self, /):
        focus   = self._fields[0]
        inner   = self._inner
        layout  = self._layout
        left    = self._label_left
        minutes = 0
        right   = self._label_right
        seconds = 0
        space   = self._space
        views   = layout.rows[0] if layout and len(layout.rows) > 1 else False

        if views:
            kwargs    = { name: getattr(views, name) for name in self._fields_sortables }
            sortables = eva.N(**kwargs)

            for cell in inner.rows[0]:
                cell.set_style(**self._style_default)
        else:
            return

        if hasattr(sortables, focus):
            style     = {**self._style_default, 'reverse': True}
            glyphless = { k: v for k, v in style.items() if k != 'glyph' }
            view      = getattr(sortables, focus)
            text      = self._glyph_sort_reverse if self._reverse else self._glyph_sort_default
            text      = text.center(view.width, space)

            view.write_text(text, **glyphless)

        if not STRESS:
            messages = self._messages_monitor
            style    = self._style_default
        elif EVENTS.stress.is_set():
            messages = self._messages_on
            seconds  = eva.normalize_integer(STRESS_CHRONO.elapsed)
            minutes  = seconds // 60
            seconds  = seconds % 60
            style    = self._style_messages_on
        else:
            messages = self._messages_off
            style    = self._style_messages_off

        for message in messages:
            message = message.format(minutes=minutes, seconds=seconds)
            length  = len(message)

            if right.width >= length and right.width >= left.width:
                label = right
            elif left.width >= length:
                label = left
            else:
                continue

            glyphless = { k: v for k, v in style.items() if k != 'glyph' }
            x         = (inner.width - length) // 2
            padding   = space * max(x - label.x, 0)
            text      = padding + message
            text      = text.ljust(label.width, space)
            text      = text[-label.width:]

            label.write_text(text, **glyphless)

            break


    def render(self, /, *, force=False):
        with self.locked():
            by_focus      = lambda cpu: getattr(cpu, focus)
            cpus          = self._snapshot.cpus
            focus         = self._fields[0]
            force         = bool(force)
            layout        = self._layout
            needs_reverse = lambda cells, value: cells and cells[0].reverse != value

            if force:
                if layout:
                    self._inner.apply_default_render()

                    fields = {
                        'frequency':   preformat_frequency(None, compact=layout.compact, ghz=layout.ghz),
                        'load':        preformat_load(None, integer=layout.integer),
                        'maxscal':     preformat_frequency(None, compact=layout.compact, ghz=layout.ghz),
                        'minscal':     preformat_frequency(None, compact=layout.compact, ghz=layout.ghz),
                        'temperature': preformat_temperature(None, integer=layout.integer),
                        'thread':      preformat_thread(None),
                    }

                    for row in layout.rows:
                        for name in fields:
                            value  = fields[name]
                            affix  = value.affix
                            length = len(affix)
                            view   = getattr(row, name)
                            cells  = reversed(view.cells) if value.full.endswith(affix) else view.cells

                            for cell in M.itertools.islice(cells, length):
                                cell.set_style(dim=True)
                else:
                    self.apply_overflow_render()

            if not layout:
                return

            if focus != self._focus_placeholder:
                cpus = sorted(cpus, key=by_focus, reverse=self._reverse)

            self._render_helper_header()

            for y, row in enumerate(layout.rows[1:] if len(layout.rows) > 1 else layout.rows):
                cpu         = cpus[self._scroll_index + y]
                frequency   = preformat_frequency(cpu.frequency, compact=layout.compact, ghz=layout.ghz)
                load        = preformat_load(cpu.load, integer=layout.integer)
                maxscal     = preformat_frequency(cpu.maxscal, compact=layout.compact, ghz=layout.ghz)
                minscal     = preformat_frequency(cpu.minscal, compact=layout.compact, ghz=layout.ghz)
                temperature = preformat_temperature(cpu.temperature, integer=layout.integer)
                thread      = preformat_thread(cpu.thread)

                row.frequency.write_text(frequency.full)
                row.load.write_text(load.full, fg=load.color.FG_DARK)
                row.maxscal.write_text(maxscal.full)
                row.minscal.write_text(minscal.full)
                row.temperature.write_text(temperature.full, fg=temperature.color.FG_DARK)
                row.thread.write_text(thread.full)

                for name in self._fields_sortables:
                    value = name == focus
                    view  = getattr(row, name)

                    if needs_reverse(view.cells, value):
                        for cell in view.cells:
                            cell.set_style(reverse=value)

                self._render_helper_bar(row=row.bar.cells, snapshot=cpu)


    def select_left(self, /):
        with self.locked():
            self._fields.rotate(1)
            self._adjust_labels()
            self.paint()


    def select_right(self, /):
        with self.locked():
            self._fields.rotate(-1)
            self._adjust_labels()
            self.paint()


    def set_geometry(self, /, *args, **kwargs):
        with self.locked():
            super().set_geometry(*args, **kwargs)
            self._adjust_inner_height()
            self._adjust_layout()
            self._adjust_blank_bar()
            self._adjust_labels()


    def toggle_reverse(self, /):
        with self.locked():
            self._reverse = not self._reverse
            self.paint()




class HistogramWindow(Window):
    _glyph_column_center = '╳'
    _glyph_column_lower  = '╲'
    _glyph_column_upper  = '╱'
    _style_blank         = {**Base._style_default, 'fg': FG.LIGHT_BLACK}


    @Window.snapshot.setter
    def snapshot(self, value, /):
        with self.locked():
            Window.snapshot.fset(self, value)

            cache    = self._cache
            snapshot = self.snapshot

            if not cache or cache[-1] != snapshot:
                cache.append(snapshot)


    def __init__(self, /, *args, **kwargs):
        super().__init__(*args, **kwargs)

        self._blank_column = Canvas(target=self)
        self._cache        = M.collections.deque(maxlen=0)

        __class__.set_geometry(self)


    def _adjust_blank_column(self, /):
        column    = self._blank_column
        height    = self._viewport.height
        center    = self._glyph_column_center if height % 2 else self._empty
        glyphless = { k: v for k, v in self._style_blank.items() if k != 'glyph' }
        lower     = self._glyph_column_lower * M.math.floor(height / 2)
        upper     = self._glyph_column_upper * M.math.floor(height / 2)
        text      = upper + center + lower

        column.set_geometry(height=height, width=1)
        column.write_text(text, **glyphless)


    def _adjust_cache_length(self, /):
        cache = self._cache

        if cache.maxlen is not None:
            maxlen = max(cache.maxlen, self._viewport.width)

            if maxlen > cache.maxlen:
                self._cache = M.collections.deque(cache, maxlen=maxlen)


    def _render_helper_column(self, /, *, column, snapshot):
        if not isinstance(column, tuple) or not isinstance(snapshot, ProcessorSnapshot):
            raise TypeError

        blank             = reversed(self._blank_column.cells)
        column            = reversed(column)
        glyphs            = GLYPHS.heavy
        height            = self._inner.height
        load              = preformat_load(snapshot.load)
        load_cells        = load.value / 100 * height
        temperature       = preformat_temperature(snapshot.current)
        temperature_cells = eva.normalize_integer(min(temperature.celsius, 100) / 100 * height)

        for y, source, destination in zip(range(height), blank, column):
            style = {}

            if temperature_cells > y:
                style['bg']    = temperature.color.BG_DARK
                style['glyph'] = self._space

            if eva.normalize_integer(load_cells) > y:
                style['fg']    = load.color.FG_LIGHT
                style['glyph'] = glyphs.ns
            elif M.math.ceil(load_cells) > y:
                style['fg']    = load.color.FG_LIGHT
                style['glyph'] = glyphs.s

            destination.copy_style_from(source, **style)


    def render(self, /, *, force=False):
        with self.locked():
            force   = bool(force)
            inner   = self._inner
            columns = inner.columns

            if force:
                cache = reversed(self._cache)

                for x in range(inner.width - 1, -1, -1):
                    column   = columns[x]
                    snapshot = next(cache, False)

                    if snapshot:
                        self._render_helper_column(column=column, snapshot=snapshot)
                    else:
                        for source, destination in zip(self._blank_column.cells, column):
                            destination.copy_style_from(source)
            elif columns:
                for right, left in zip(columns[1:], columns):
                    for source, destination in zip(right, left):
                        destination.copy_style_from(source)

                self._render_helper_column(column=columns[-1], snapshot=self.snapshot)


    def set_geometry(self, /, *args, **kwargs):
        with self.locked():
            super().set_geometry(*args, **kwargs)
            self._adjust_blank_column()
            self._adjust_cache_length()




class ValueWindow(Window):
    _class_lock  = M.threading.RLock()
    _common_font = False
    _instances   = M.weakref.WeakSet()


    def __init__(self, /, *args, **kwargs):
        super().__init__(*args, **kwargs)

        with self.locked():
            __class__._instances.add(self)
            __class__._calc_common_font()


    @staticmethod
    def _calc_common_font():
        __class__._common_font = False

        by_size         = lambda font: (font.height, font.width)
        fonts           = sorted(vars(FONTS).values(), key=by_size, reverse=True)
        instances       = tuple(__class__._instances)
        max_load        = len(preformat_load(None).full)
        max_temperature = len(preformat_temperature(None).full)
        max_value       = max(max_load, max_temperature)
        minimum_height  = min( instance._viewport.height for instance in instances )
        minimum_width   = min( instance._viewport.width  for instance in instances )

        for font in fonts:
            if font.height <= minimum_height and font.width * max_value <= minimum_width:
                __class__._common_font = font

                break
        else:
            return

        height = font.height
        width  = font.width * max_value

        for instance in instances:
            x = (instance._viewport.width  - width)       / 2
            y = (instance._viewport.height - font.height) / 2

            x = M.math.floor(x)
            y = M.math.ceil(y)

            instance._inner.set_geometry(height=height, width=width, x=x, y=y)


    @M.abc.abstractmethod
    def _get_preformatted_value(self, /):
        pass


    @M.contextlib.contextmanager
    def locked(self, /):
        # Simplifying to the class lock is tempting, but both are needed when
        # the target requires locking (when it's not a terminal).
        with __class__._class_lock:
            with super().locked():
                yield


    def render(self, /, *, force=False):
        with self.locked():
            font  = __class__._common_font
            force = bool(force)
            inner = self._inner
            value = self._get_preformatted_value()

            if force:
                if font:
                    self._viewport.apply_default_render()

                    length = font.width * len(value.affix)

                    for y in range(font.height):
                        row = reversed(inner.rows[y])

                        for cell in M.itertools.islice(row, length):
                            cell.set_style(dim=True)
                else:
                    self.apply_overflow_render()

            if not font:
                return

            for y in range(font.height):
                line = ( font.glyphs.get(char, font.fallback)[y] for char in value.full )
                line = self._empty.join(line)
                line = reversed(line)
                row  = reversed(inner.rows[y])

                for char, cell in zip(line, row):
                    cell.set_style(fg=value.color.FG_DARK, glyph=char)


    def set_geometry(self, /, *args, **kwargs):
        with self.locked():
            super().set_geometry(*args, **kwargs)
            __class__._calc_common_font()




class CurrentWindow(ValueWindow):
    def _get_preformatted_value(self, /):
        return preformat_temperature(self._snapshot.current)




class LoadWindow(ValueWindow):
    def _get_preformatted_value(self, /):
        return preformat_load(self._snapshot.load)




class MaximumWindow(ValueWindow):
    def _get_preformatted_value(self, /):
        return preformat_temperature(self._snapshot.maximum)


    def render(self, /, *args, force=False, **kwargs):
        with self.locked():
            if BREATHER.expired:
                __class__.render = ValueWindow.render

                super().render(*args, force=True, **kwargs)
            elif __class__._common_font:
                self._viewport.apply_noise_render()
            else:
                self.apply_overflow_render()




class MinimumWindow(ValueWindow):
    def _get_preformatted_value(self, /):
        return preformat_temperature(self._snapshot.minimum)




class SmoothedWindow(ValueWindow):
    def _get_preformatted_value(self, /):
        return preformat_temperature(self._snapshot.smoothed)




