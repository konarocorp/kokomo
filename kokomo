def target_keyboard():
    try:
        code_arrow_down  = b'\x1B[B'
        code_arrow_left  = b'\x1B[D'
        code_arrow_right = b'\x1B[C'
        code_arrow_up    = b'\x1B[A'
        code_escape      = b'\x1B'
        code_lower_q     = b'q'
        code_lower_r     = b'r'
        code_space       = b' '
        code_upper_q     = code_lower_q.upper()
        code_upper_r     = code_lower_r.upper()
        codes_break      = (code_escape, code_lower_q, code_upper_q)

        dispatcher = {
            code_arrow_down:  WINDOWS.cpus.scroll_down,
            code_arrow_left:  WINDOWS.cpus.select_left,
            code_arrow_right: WINDOWS.cpus.select_right,
            code_arrow_up:    WINDOWS.cpus.scroll_up,
            code_lower_r:     WINDOWS.cpus.toggle_reverse,
            code_space:       toggle_stress,
            code_upper_r:     WINDOWS.cpus.toggle_reverse,
        }

        with eva.Reader() as reader:
            while not EVENTS.bye.is_set():
                chunk = reader.poll()

                if chunk is None:
                    continue
                elif chunk in codes_break or chunk is False:
                    break

                dispatcher.get(chunk, eva.noop)()
    finally:
        EVENTS.bye.set()




def target_mouse():
    try:
        ansi_mouse_off  = '\x1B[?1000l'
        ansi_mouse_on   = '\x1B[?1000h'
        code_wheel_down = b'\x1B\x5B\x4D\x61'
        code_wheel_up   = b'\x1B\x5B\x4D\x60'
        debouncer       = eva.Chrono(timeout=eva.SECOND / 100)
        previous        = None

        dispatcher = {
            code_wheel_down: WINDOWS.cpus.scroll_down,
            code_wheel_up:   WINDOWS.cpus.scroll_up,
        }

        TERMINAL.write(ansi_mouse_on)

        with eva.Reader() as reader:
            while not EVENTS.bye.is_set():
                chunk = reader.poll()

                if chunk is None:
                    continue
                elif chunk is False:
                    break
                elif (chunk := chunk[0:4]) == previous and not debouncer.expired:
                    continue
                else:
                    previous = chunk

                    debouncer.reset()

                dispatcher.get(chunk, eva.noop)()
    finally:
        TERMINAL.write(ansi_mouse_off)
        EVENTS.bye.set()




def target_screen():
    try:
        bye      = EVENTS.bye
        debounce = eva.SECOND / 10
        guides   = vars(GUIDES).values()
        previous = None
        screen   = EVENTS.screen
        sigwinch = EVENTS.sigwinch
        windows  = vars(WINDOWS).values()

        while True:
            screen.wait()

            if bye.is_set():
                break
            else:
                screen.clear()

            snapshot    = SNAPSHOT
            current     = len(snapshot.cpus)
            recalculate = sigwinch.is_set() or previous != current

            if recalculate:
                TERMINAL.clear_screen()

                if sigwinch.is_set():
                    sigwinch.clear()

                    while sigwinch.wait(debounce):
                        if bye.is_set():
                            return
                        else:
                            sigwinch.clear()

                calc_positions_and_sizes(cpus=current)

                for guide in guides:
                    guide.paint(force=True)

            for window in windows:
                window.snapshot = snapshot

                window.paint(force=recalculate)

            previous    = current
            recalculate = False
    finally:
        EVENTS.bye.set()




def target_snapshot():
    try:
        global SNAPSHOT

        by_thread        = lambda cpu: cpu.thread
        calc_timeout     = lambda interval: interval - (clock.elapsed % interval) if interval else 0.0
        clock            = eva.Chrono()
        cpu_fields       = tuple( field.name for field in M.dataclasses.fields(CPUSnapshot) )
        max_temp         = TEMPERATURE_MINIMUM
        min_temp         = TEMPERATURE_MAXIMUM
        smoothed_chrono  = eva.Chrono(timeout=0)
        smoothed_samples = M.collections.deque()
        snapshot_chrono  = eva.Chrono(timeout=0)

        while True:
            while smoothed_samples and smoothed_samples[0].chrono.expired:
                smoothed_samples.popleft()

            temperature = eva.CPU.temperature

            if smoothed_chrono.expired or not smoothed_samples:
                sample = eva.N(chrono=eva.Chrono(timeout=TIMEOUT_SMOOTHED), temperature=temperature)

                smoothed_samples.append(sample)
                smoothed_chrono.reset(timeout=calc_timeout(INTERVAL_SMOOTHED))

            if snapshot_chrono.expired:
                cpus_samples = []
                load         = eva.CPU.load
                max_temp     = max(temperature, max_temp) if BREATHER.expired else temperature
                min_temp     = min(temperature, min_temp)

                for cpu in eva.CPU.get_cpus(auto=True, online=True):
                    kwargs = { field: getattr(cpu, field) for field in cpu_fields }
                    sample = CPUSnapshot(**kwargs)

                    cpus_samples.append(sample)

                cpus_samples.sort(key=by_thread)

                kwargs             = {}
                kwargs['cpus']     = tuple(cpus_samples)
                kwargs['current']  = temperature
                kwargs['load']     = load
                kwargs['maximum']  = max_temp
                kwargs['minimum']  = min_temp
                kwargs['smoothed'] = M.statistics.mean( sample.temperature for sample in smoothed_samples )
                SNAPSHOT           = ProcessorSnapshot(**kwargs)

                snapshot_chrono.reset(timeout=calc_timeout(INTERVAL_SNAPSHOT))
                EVENTS.screen.set()

            if EVENTS.bye.wait(min(smoothed_chrono.remaining, snapshot_chrono.remaining)):
                break
    finally:
        EVENTS.bye.set()




def target_stress():
    if STRESS:
        try:
            context = M.multiprocessing.get_context('spawn')
            tasks   = []

            def append_task(cpu, /):
                ppid    = M.os.getpid()
                stop    = context.Event()
                args    = (cpu, ppid, stop)
                process = context.Process(args=args, daemon=True, target=target_stressor)
                task    = eva.N(cpu=cpu, process=process, stop=stop)

                tasks.append(task)
                process.start()

                with M.contextlib.suppress(OSError):
                    M.os.sched_setaffinity(process.pid, {task.cpu})

            def discard_task(task, /):
                task.stop.set()
                task.process.join()
                tasks.remove(task)

            while True:
                bye = EVENTS.bye.is_set()

                if bye or not EVENTS.stress.is_set():
                    for task in list(tasks):
                        discard_task(task)

                    if bye:
                        break
                    else:
                        EVENTS.stress.wait()

                for task in list(tasks):
                    try:
                        affinity = M.os.sched_getaffinity(task.process.pid)
                    except OSError:
                        affinity = None

                    if affinity != {task.cpu} or not task.process.is_alive():
                        append_task(task.cpu)
                        discard_task(task)

                cpus = set(eva.CPU.get_cpus(online=True)) - set( task.cpu for task in tasks )

                for cpu in cpus:
                    append_task(cpu)
        finally:
            EVENTS.bye.set()




def target_stressor(cpu, ppid, stop, /):
    cpu    = int(cpu)
    mask   = {cpu}
    option = 1 # PR_SET_PDEATHSIG
    pid    = 0
    ppid   = int(ppid)

    M.ctypes.CDLL(None).prctl(option, M.signal.SIGTERM)

    if ppid == M.os.getppid():
        with M.contextlib.suppress(OSError):
            M.os.setsid()
            M.os.sched_setaffinity(pid, mask)

            while not stop.is_set():
                pass




